# Copy to .env, or just export these in your shell. Nothing here is a secret --
# they are locations, and the app reads no credentials of any kind.

# Your desk: config, positions, research output. Never inside this repository.
# Resolution order is deskRoot in the app's own data/config.json, then this, then
# ~/trading-desk.
DESK_ROOT=~/trading-desk

# A KiroCrew checkout's src/, so the test suite can import the real AppRoute and
# AppContext. Colon-separated if you have several. Without it, the tests that need
# the gateway skip and the rest still run.
KIROCREW_SRC=

# Your gateway home, when it is not the default. Only the install script and the
# self-heal cron read it; they probe ~/.kirocrew then ~/.kiro/crew otherwise.
KIROCREW_HOME=
